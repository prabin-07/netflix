<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#141414">
    <title>Add a Movie | Netflix</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" href="../files/netflix.png" type="image/x-icon">
</head>
<body class="add-page">
    <header class="site-header">
        <a class="wordmark" href="/" aria-label="Netflix home">NETFLIX</a>
        <nav class="main-nav" aria-label="Main navigation">
            <a href="/Movies">Home</a>
            <a href="/Movies/addMovies">Movies</a>
        </nav>
        <a class="header-action" href="/Movies">Back to home <span aria-hidden="true">→</span></a>
    </header>
    <main class="form-layout">
        <div class="form-intro">
            <p class="section-kicker">GROW YOUR COLLECTION</p>
            <h1>Add a movie</h1>
            <p>Bring another great story to your Netflix shelf. Add the details below to save it to your collection.</p>
            <div class="form-art" aria-hidden="true"><span>N</span></div>
        </div>
        <section class="form-card" aria-labelledby="form-title">
            <h2 id="form-title">Movie details</h2>
            <p class="form-note">Fields marked with <span>*</span> are required.</p>
            <form action="/Movies/addMovies" method="post">
                <div class="field-group">
                    <label for="movie_title">Movie title <span>*</span></label>
                    <input id="movie_title" name="title" type="text" placeholder="e.g. The Grand Budapest Hotel" required maxlength="150" autocomplete="off">
                </div>
                <div class="field-row">
                    <div class="field-group">
                        <label for="movie_genre">Genre</label>
                        <input id="movie_genre" name="genre" type="text" placeholder="e.g. Drama" maxlength="80">
                    </div>
                    <div class="field-group">
                        <label for="movie_year">Release year</label>
                        <input id="movie_year" name="year" type="number" min="1888" max="2100" inputmode="numeric" placeholder="e.g. 2024">
                    </div>
                </div>
                <div class="field-group">
                    <label for="description">Description</label>
                    <textarea id="description" name="description" rows="4" placeholder="What makes this movie worth watching?" maxlength="1000"></textarea>
                </div>
                <div class="field-row">
                    <div class="field-group">
                        <label for="rating">Rating</label>
                        <input id="rating" name="rating" type="number" step="any" placeholder="e.g. 8.5" inputmode="decimal">
                    </div>
                </div>
                <div class="field-row">
                    <div class="field-group">
                        <label for="language">Language</label>
                        <input id="language" name="language" type="text" placeholder="e.g. English" maxlength="80">
                    </div>
                    <div class="field-group">
                        <label for="cast">Cast</label>
                        <input id="cast" name="cast" type="text" placeholder="e.g. Actor One, Actor Two" maxlength="500">
                    </div>
                </div>
                <div class="form-actions">
                    <a class="button button-outline" href="/">Cancel</a>
                    <button class="button button-red" type="submit">Add movie</button>
                </div>
            </form>
        </section>
    </main>
    <footer class="site-footer"><span class="wordmark footer-mark">NETFLIX</span><span>Your movie night, your way.</span></footer>
</body>
</html>
