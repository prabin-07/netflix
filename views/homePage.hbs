<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#141414">
    <title>Netflix</title>
    <link rel="icon" href="../public/css/files/netflix.png" type="image/png">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="home-page">
    <header class="site-header">
        <a class="wordmark" href="/" aria-label="Netflix home">NETFLIX</a>
        <nav class="main-nav" aria-label="Main navigation">
            <a class="active" href="/">Home</a>
            <a href="/Movies/movieList">Movies</a>
            <a href="#series">Series</a>
            <a href="#my-list">My List</a>
        </nav>
    </header>

    <main>
        <section class="hero" aria-labelledby="hero-title">
            <div class="hero-art" aria-hidden="true"></div>
            <div class="hero-copy">
                <p class="eyebrow"><span class="mini-mark">N</span> FILM SPOTLIGHT</p>
                <h1 id="hero-title">Stories worth<br>staying in for.</h1>
                <p class="hero-description">Discover your next favorite film. Explore acclaimed stories, new releases, and hidden gems picked for your night in.</p>
                <div class="hero-buttons">
                    <a class="button button-light" href="#films"><span aria-hidden="true">▶</span> Explore films</a>
                    <a class="button button-muted" href="#my-list"><span aria-hidden="true">ⓘ</span> More info</a>
                </div>
            </div>
            <div class="hero-fade" aria-hidden="true"></div>
        </section>

        <section class="catalogue" id="films" aria-labelledby="films-title">
            <div class="section-heading">
                <div>
                    <p class="section-kicker">YOUR NEXT FAVORITE</p>
                    <h2 id="films-title">Popular on Netflix</h2>
                </div>
                <a class="text-link" name="movie_add" href="/Movies/addMovies">＋ Add movie</a>
            </div>
            {{#if movies}}
            <div class="movie-grid">
                {{#each movies}}
                <article class="movie-card">
                    <div class="movie-poster" {{#if this.posterUrl}}style="--poster-image: url('{{this.posterUrl}}')"{{/if}}>
                        <span class="poster-n">N</span>
                    <span class="poster-label">{{this.movie_genre}}</span>
                    </div>
                    <div class="movie-info">
                        <h3>{{this.movie_title}}</h3>
                        <p>{{this.release_year}} <span aria-hidden="true">&bull;</span> {{this.movie_language}}</p>
                        <p class="movie-rating">Rating: {{this.movie_rating}}</p>
                        {{#if this.movie_description}}<p class="movie-description">{{this.movie_description}}</p>{{/if}}
                        {{#if this.movie_cast}}<p class="movie-cast">Cast: {{this.movie_cast}}</p>{{/if}}
                        <a class="movie-view" href="/Movies/{{_id}}">View More</a>
                    </div>
                </article>
                {{/each}}
            </div>
            {{else}}
            <div class="empty-state">
                <div class="empty-icon" aria-hidden="true">▶</div>
                <h3>Your movie collection starts here</h3>
                <p>Add a title to fill your home screen with something great to watch.</p>
                <a class="button button-red" name="movie_add" href="/Movies/addMovies">Add your first movie</a>
            </div>
            {{/if}}
        </section>
        

        <section class="browse-banner" id="my-list">
            <div><p class="section-kicker">MAKE IT YOURS</p><h2>A screen full of stories.</h2><p>Add films to build your own collection.</p></div>
            <a class="button button-light" name="movie_add" href="/Movies/addMovies">＋ Add a movie</a>
        </section>
    </main>
    <footer class="site-footer"><span class="wordmark footer-mark">NETFLIX</span><span>Enjoy your next movie night.</span></footer>
</body>
</html>
