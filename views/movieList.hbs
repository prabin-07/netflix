<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#141414">
    <title>Movies | Netflix</title>
    <link rel="icon" href="../public/css/files/netflix.png" type="image/x-icon">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="movie-list-page">
    <header class="site-header">
        <a class="wordmark" href="/" aria-label="Netflix home">NETFLIX</a>
        <nav class="main-nav" aria-label="Main navigation">
            <a href="/">Home</a>
            <a class="active" href="/Movies/movieList">Movies</a>
        </nav>
        <a class="header-action" href="/Movies/movieList">Browse</a>
    </header>

    <main class="movie-list-main">
        {{#if mov}}
        <section class="hero movie-detail-hero" aria-labelledby="movie-title">
            <div class="hero-art" aria-hidden="true">
                <span class="poster-label">{{mov.movie_genre}}</span>
            </div>
            <div class="hero-copy">
                <p class="eyebrow"><span class="mini-mark">N</span> NETFLIX FILM</p>
                <h1 id="movie-title">{{mov.movie_title}}</h1>
                <p class="movie-detail-meta">{{mov.release_year}} <span aria-hidden="true">&bull;</span> {{mov.movie_genre}} <span aria-hidden="true">&bull;</span> {{mov.movie_language}}</p>
                <p class="movie-rating">Rating: {{mov.movie_rating}}</p>
                {{#if mov.movie_description}}<p class="hero-description">{{mov.movie_description}}</p>{{/if}}
                {{#if mov.movie_cast}}<p class="movie-cast">Cast: {{mov.movie_cast}}</p>{{/if}}
                <div class="hero-buttons">
                    <a class="button button-light" href="/">&#8592; Home</a>
                    <a class="button button-muted" href="/Movies/movieList">Browse movies</a>
                </div>
            </div>
            <div class="hero-fade" aria-hidden="true"></div>
        </section>
        {{else}}
        <section class="movie-list-heading">
            <p class="section-kicker">YOUR COLLECTION</p>
            <h1>Movies</h1>
            <p>Browse the titles in your collection.</p>
        </section>
        {{/if}}

        {{#if mov}}
        {{!-- Movie detail is shown in the spotlight above. --}}
        {{else if value}}
        <section class="movie-grid" aria-label="Movie collection">
            {{#each value}}
            <article class="movie-card">
                <div class="movie-poster">
                    <span class="poster-n" aria-hidden="true">N</span>
                    <span class="poster-label">{{this.movie_genre}}</span>
                </div>
                <details class="movie-info">
                    <summary>View more</summary>
                    <h2>{{this.movie_title}}</h2>
                    <p>{{this.release_year}} <span aria-hidden="true">&bull;</span> {{this.movie_language}}</p>
                    <p class="movie-rating">Rating: {{this.movie_rating}}</p>
                    {{#if this.movie_description}}<p class="movie-description">{{this.movie_description}}</p>{{/if}}
                    {{#if this.movie_cast}}<p class="movie-cast">Cast: {{this.movie_cast}}</p>{{/if}}
                </details>
            </article>
            {{/each}}
        </section>
        {{else}}
        <section class="empty-state">
            <div class="empty-icon" aria-hidden="true">&#9654;</div>
            <h2>No movies yet</h2>
            <p>Add a movie to start building your collection.</p>
            <a class="button button-red" href="/Movies/movieList">Browse movies</a>
        </section>
        {{/if}}
    </main>

    <footer class="site-footer"><span class="wordmark footer-mark">NETFLIX</span><span>Enjoy your next movie night.</span></footer>
</body>
</html>
